# code-builder 敏感变量示例
# 复制为 .env 后填写；docker-compose.yml 通过 env_file 读取。
# 非敏感配置请写 config/config.yaml。

# 必填：三个平台共用的 Webhook Secret
WEBHOOK_SECRET=change-me-to-a-long-random-string

# 可选：平台 HTTPS clone token（私有仓库）
GITLAB_TOKEN=
GITHUB_TOKEN=
GITEE_TOKEN=

# 可选：镜像仓库密码，对应 config.yaml 的 registry.password
REGISTRY_PASSWORD=

# 可选：飞书机器人
LARK_WEBHOOK_URL=
LARK_SECRET=

# 可选：日志级别临时覆盖（默认取 config.yaml 的 server.log_level）
# LOG_LEVEL=info

# 可选：旧版 GitLab 变量兼容
# GITLAB_WEBHOOK_SECRET=
# GITLAB_DEPLOY_KEY_PATH=
